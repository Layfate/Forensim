    <string name="ob_ai_title">AI tutor: privacy at datos</string>
    <string name="ob_ai_1">Gumagamit ang AI tutor ng Forensim ng third-party na AI model (Anthropic) para sagutin ang mga tanong tungkol sa iyong mga aralin.</string>
    <string name="ob_ai_2">Kapag nagtanong ka, ipinapadala ang tanong mo, ang kamakailang usapan at mga kaugnay na bahagi ng aralin para masagot ka. Kung tungkol sa progreso mo ang tanong, kasama ang maikling buod ng iyong mga resulta.</string>
    <string name="ob_ai_3">Hindi namin iniimbak sa aming server ang teksto ng mga tanong mo o ng sagot ng tutor, tala lang ng paggamit para sa pang-araw-araw na limitasyon.</string>
    <string name="ob_ai_4">Maaaring mali ang sagot ng AI. Suriin ang mahahalagang punto sa iyong mga aralin at sa iyong propesor. Naka-lock ang tutor habang may graded na quiz o kaso.</string>
    <string name="ob_ai_accept">Sige, simulan na natin</string>
    <string name="ob_ai_footer">Sa pagpapatuloy, tinatanggap mo ang aming Terms of Use at Privacy Policy (tingnan sa Settings).</string>
    <string name="ex_cases_q">Ano ito?</string>
    <string name="ex_cases_a">Cartridge case (basyo)</string>
    <string name="ex_cases_hint">Naiiwan matapos iputok ang baril</string>
    <string name="ex_cases_fact">Ang marka ng firing pin, breech face at ejector sa basyo ay maaaring mag-ugnay nito sa isang partikular na baril.</string>
    <string name="ex_rifling_q">Ano ang tawag sa mga paikot na ukang ito?</string>
    <string name="ex_rifling_a">Rifling</string>
    <string name="ex_rifling_hint">Tinitingnan mo ang loob ng bariles ng baril</string>
    <string name="ex_rifling_fact">Pinaiikot ng rifling ang bala at nag-iiwan ito ng lands at grooves na itinutugma ng mga eksaminer sa isang bariles.</string>
    <string name="ex_comparison_q">Anong instrumento ito?</string>
    <string name="ex_comparison_a">Comparison microscope</string>
    <string name="ex_comparison_hint">Ipinapakita ang dalawang bala nang magkatabi sa iisang tanawin</string>
    <string name="ex_comparison_fact">Pinagdudugtong ng optical bridge ang dalawang mikroskopyo para makita ng eksaminer ang dalawang sample sa iisang eyepiece.</string>
    <string name="ex_bullets_q">Ano ang mga ito?</string>
    <string name="ex_bullets_a">Mga bala (bullets)</string>
    <string name="ex_bullets_hint">Iba\'t ibang disenyo ng projectile, hinati sa gitna</string>
    <string name="ex_bullets_fact">Ang bala ay ang projectile lamang. Ang buong round, kasama ang basyo, pulbura at primer, ay tinatawag na cartridge.</string>
    <string name="ex_bag_q">Saan isinisilid ng imbestigador ang ebidensya?</string>
    <string name="ex_bag_a">Papel na evidence bag</string>
    <string name="ex_bag_hint">Sinasarhan, nilalagyan ng label at pinipirmahan ito</string>
    <string name="ex_bag_fact">Sa papel, hindi plastik, inilalagay ang biological na ebidensya para matuyo ito at hindi amagin.</string>
    <string name="ex_marquis_q">Anong uri ng test ito?</string>
    <string name="ex_marquis_a">Marquis test</string>
    <string name="ex_marquis_hint">Ang pagbabago ng kulay ay pang-screen ng droga</string>
    <string name="ex_marquis_fact">Presumptive test ang Marquis reagent: ang pagbabago ng kulay ay nagpapahiwatig ng uri ng droga pero hindi ito patunay.</string>
    <string name="ex_tlc_q">Anong pamamaraan ang gumawa ng mga tuldok na ito?</string>
    <string name="ex_tlc_a">Thin-layer chromatography</string>
    <string name="ex_tlc_hint">Pinaghihiwalay ang isang mixture sa mga tuldok sa isang plate</string>
    <string name="ex_tlc_fact">Bawat compound ay umaabot sa takdang layo (ang Rf value nito), kaya naikukumpara ang mga tuldok sa mga kilalang pamantayan.</string>
    <string name="ex_obscura_q">Anong aparato ito?</string>
    <string name="ex_obscura_a">Camera obscura</string>
    <string name="ex_obscura_hint">Madilim na kahon na may maliit na butas na nagpapakita ng larawan</string>
    <string name="ex_obscura_fact">Ang liwanag na dumaan sa maliit na butas ay nagpapakita ng baligtad na larawan. Ito ang prinsipyo sa likod ng bawat kamera.</string>
    <string name="ex_cards_q">Ano ang mga ito?</string>
    <string name="ex_cards_a">Mga memory card</string>
    <string name="ex_cards_hint">Dito nakaimbak ang mga digital na larawan ng crime scene</string>
    <string name="ex_cards_fact">Iniingatan ang orihinal na card at kinokopya gamit ang hash check, para walang makapagsabing binago ang mga larawan.</string>
    <string name="ex_slr_q">Anong uri ng kamera ang ipinapakita ng diagram na ito?</string>
    <string name="ex_slr_a">SLR camera</string>
    <string name="ex_slr_hint">May salamin na nagpapakita kung ano mismo ang nakikita ng lente</string>
    <string name="ex_slr_fact">Sa single-lens reflex na kamera, ipinapasa ng salamin ang larawan sa viewfinder, at tumataas ito kapag kumukuha ka ng litrato.</string>
    <string name="ex_bertillon_q">Anong uri ng rekord ito?</string>
    <string name="ex_bertillon_a">Bertillon card</string>
    <string name="ex_bertillon_hint">Mga sukat at larawan ng isang inarestong tao, dekada 1890</string>
    <string name="ex_bertillon_fact">Kinilala ni Alphonse Bertillon ang mga kriminal sa pamamagitan ng sukat ng katawan hanggang mapalitan ito ng fingerprints.</string>
    <string name="ex_polygraph_q">Anong makina ito?</string>
    <string name="ex_polygraph_a">Polygraph</string>
    <string name="ex_polygraph_hint">Itinatala ang paghinga, pulso at pagpapawis</string>
    <string name="ex_polygraph_fact">Sinusukat ng polygraph ang reaksyon ng katawan sa mga tanong. Hindi nito direktang natutukoy ang kasinungalingan.</string>
    <string name="ex_polytest_q">Anong test ang ibinibigay dito?</string>
    <string name="ex_polytest_a">Polygraph test</string>
    <string name="ex_polytest_hint">Nagtatanong habang itinatala ang reaksyon ng katawan</string>
    <string name="ex_polytest_fact">Pinahusay ni Leonarde Keeler ang polygraph noong dekada 1930, at ginamit ito ng pulisya sa buong US.</string>
    <string name="ex_signatures_q">Ano ang pinaghahambing dito?</string>
    <string name="ex_signatures_a">Mga lagda (signatures)</string>
    <string name="ex_signatures_hint">Questioned documents: may peke sa mga ito</string>
    <string name="ex_signatures_fact">Ikinukumpara ng mga eksaminer ang hugis ng letra, diin ng panulat at pagkadulas ng sulat. Kadalasang mabagal at nanginginig ang mga peke.</string>
    <string name="ex_stereo_q">Anong instrumento ito?</string>
    <string name="ex_stereo_a">Stereo microscope</string>
    <string name="ex_stereo_hint">Nagbibigay ng 3D na tanawin sa mababang magnification</string>
    <string name="ex_stereo_fact">Ginagamit ito ng mga document examiner para suriin ang linya ng tinta, stroke ng panulat at hibla ng papel.</string>
    <string name="ex_typewriter_q">Ano ito?</string>
    <string name="ex_typewriter_a">Makinilya (typewriter)</string>
    <string name="ex_typewriter_hint">Bawat isa ay nag-iiwan ng sariling maliliit na depekto sa mga letra</string>
    <string name="ex_typewriter_fact">Ang luma o hindi nakahanay na mga tipo ay maaaring mag-ugnay ng isang dokumento sa isang partikular na makina.</string>
    <string name="ex_paracelsus_q">Sino ito?</string>
    <string name="ex_paracelsus_a">Paracelsus</string>
    <string name="ex_paracelsus_hint">Ama ng toxicology: \"ang dosis ang gumagawa ng lason\"</string>
    <string name="ex_paracelsus_fact">Itinuro ni Paracelsus (1493 hanggang 1541) na anumang sangkap ay maaaring maging lason kapag sapat ang taas ng dosis.</string>
