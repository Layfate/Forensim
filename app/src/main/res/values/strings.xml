    <string name="ob_ai_footer">By continuing, you accept our Terms of Use and Privacy Policy (see Settings).</string>
    <string name="ex_cases_q">What is this?</string>
    <string name="ex_cases_a">Cartridge case</string>
    <string name="ex_cases_hint">Left behind after a gun is fired</string>
    <string name="ex_cases_fact">Firing pin, breech face and ejector marks on a case can link it to one specific gun.</string>
    <string name="ex_rifling_q">What are these spiral grooves called?</string>
    <string name="ex_rifling_a">Rifling</string>
    <string name="ex_rifling_hint">You\'re looking down the inside of a gun barrel</string>
    <string name="ex_rifling_fact">Rifling spins the bullet and engraves lands and grooves on it, which examiners match to a barrel.</string>
    <string name="ex_comparison_q">What instrument is this?</string>
    <string name="ex_comparison_a">Comparison microscope</string>
    <string name="ex_comparison_hint">Shows two bullets side by side in one view</string>
    <string name="ex_comparison_fact">An optical bridge joins two microscopes so the examiner sees both samples through one eyepiece.</string>
    <string name="ex_bullets_q">What are these?</string>
    <string name="ex_bullets_a">Bullets</string>
    <string name="ex_bullets_hint">Projectiles of different designs, cut in half</string>
    <string name="ex_bullets_fact">The bullet is only the projectile. The whole round, with case, powder and primer, is a cartridge.</string>
    <string name="ex_bag_q">What is the investigator packing the evidence into?</string>
    <string name="ex_bag_a">Paper evidence bag</string>
    <string name="ex_bag_hint">It gets sealed, labelled and signed</string>
    <string name="ex_bag_fact">Biological evidence goes in paper, not plastic, so it can dry out instead of growing mould.</string>
    <string name="ex_marquis_q">What kind of test is this?</string>
    <string name="ex_marquis_a">Marquis test</string>
    <string name="ex_marquis_hint">A colour change screens for drugs</string>
    <string name="ex_marquis_fact">The Marquis reagent is a presumptive test: a colour change suggests a drug class but does not prove it.</string>
    <string name="ex_tlc_q">What technique made these spots?</string>
    <string name="ex_tlc_a">Thin-layer chromatography</string>
    <string name="ex_tlc_hint">Separates a mixture into spots on a plate</string>
    <string name="ex_tlc_fact">Each compound travels a set distance (its Rf value), so spots can be compared with known standards.</string>
    <string name="ex_obscura_q">What is this device?</string>
    <string name="ex_obscura_a">Camera obscura</string>
    <string name="ex_obscura_hint">A dark box with a tiny hole that projects an image</string>
    <string name="ex_obscura_fact">Light through a small hole projects an upside-down image, the principle behind every camera.</string>
    <string name="ex_cards_q">What are these?</string>
    <string name="ex_cards_a">Memory cards</string>
    <string name="ex_cards_hint">Where digital crime-scene photos are stored</string>
    <string name="ex_cards_fact">Original cards are preserved and copied with a hash check, so nobody can claim the photos were altered.</string>
    <string name="ex_slr_q">What kind of camera does this diagram show?</string>
    <string name="ex_slr_a">SLR camera</string>
    <string name="ex_slr_hint">A mirror lets you see exactly what the lens sees</string>
    <string name="ex_slr_fact">In a single-lens reflex camera, a mirror sends the image to the viewfinder, then flips up when you shoot.</string>
    <string name="ex_bertillon_q">What kind of record is this?</string>
    <string name="ex_bertillon_a">Bertillon card</string>
    <string name="ex_bertillon_hint">Measurements and photos of an arrested person, 1890s</string>
    <string name="ex_bertillon_fact">Alphonse Bertillon identified criminals by body measurements until fingerprints replaced his system.</string>
    <string name="ex_polygraph_q">What is this machine?</string>
    <string name="ex_polygraph_a">Polygraph</string>
    <string name="ex_polygraph_hint">Records breathing, pulse and sweating</string>
    <string name="ex_polygraph_fact">A polygraph measures the body\'s reactions to questions. It does not detect lies directly.</string>
    <string name="ex_polytest_q">What test is being given here?</string>
    <string name="ex_polytest_a">Polygraph test</string>
    <string name="ex_polytest_hint">Questions are asked while the body\'s reactions are recorded</string>
    <string name="ex_polytest_fact">Leonarde Keeler improved the polygraph in the 1930s, and police across the US adopted it.</string>
    <string name="ex_signatures_q">What is being compared here?</string>
    <string name="ex_signatures_a">Signatures</string>
    <string name="ex_signatures_hint">Questioned documents: some of these are forged</string>
    <string name="ex_signatures_fact">Examiners compare letter shapes, pen pressure and fluency. Forgeries are often slow and shaky.</string>
    <string name="ex_stereo_q">What instrument is this?</string>
    <string name="ex_stereo_a">Stereo microscope</string>
    <string name="ex_stereo_hint">Gives a 3D view at low magnification</string>
    <string name="ex_stereo_fact">Document examiners use it to study ink lines, pen strokes and paper fibres.</string>
    <string name="ex_typewriter_q">What is this?</string>
    <string name="ex_typewriter_a">Typewriter</string>
    <string name="ex_typewriter_hint">Each one leaves its own small flaws in the letters</string>
    <string name="ex_typewriter_fact">Worn or misaligned typefaces can link a typed document to one specific machine.</string>
    <string name="ex_paracelsus_q">Who is this?</string>
    <string name="ex_paracelsus_a">Paracelsus</string>
    <string name="ex_paracelsus_hint">Father of toxicology: \"the dose makes the poison\"</string>
    <string name="ex_paracelsus_fact">Paracelsus (1493 to 1541) taught that any substance can be a poison at a high enough dose.</string>
</resources>
