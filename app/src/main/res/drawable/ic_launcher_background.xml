<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background: glossy maroon gradient. Keep in sync with art/scripts/make_icons.py,
     which renders the same layers for the legacy icons and the Play Store graphics. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base: light maroon at the top left to deep wine at the bottom right. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FFB8395A" />
                <item android:offset="0.45" android:color="#FF85233F" />
                <item android:offset="0.8" android:color="#FF571229" />
                <item android:offset="1" android:color="#FF3A0A19" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Shine: soft light from the top left. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="30" android:centerY="22" android:gradientRadius="64">
                <item android:offset="0" android:color="#4DFFE0E8" />
                <item android:offset="0.55" android:color="#12FFE0E8" />
                <item android:offset="1" android:color="#00FFE0E8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Gloss: faint sheen over the upper half. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="58">
                <item android:offset="0" android:color="#26FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Depth: darker corner at the bottom right. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="96" android:centerY="100" android:gradientRadius="58">
                <item android:offset="0" android:color="#40000000" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
