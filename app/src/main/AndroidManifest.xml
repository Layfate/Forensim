<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Online/offline dot on the profile avatar. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Short vibration on 3D lab feedback (Settings > Sound > Vibration). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+: asked from Settings > Notifications, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AR evidence viewer: the camera shows the room (asked only when AR is opened; nothing is recorded). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- OpenGL ES 3.0 for the 3D lab and evidence viewer. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- AR-optional (plan section 6.4): camera and motion sensors are never required, so phones
         without them (or without ARCore) still install and get the full curriculum. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:name=".ForensimApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forensim">
        <!-- ARCore is optional: the app installs everywhere and offers AR only where it is supported. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Forensim"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth (Google / Facebook) redirect. Add this URL to Supabase → Authentication → URL Configuration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.forensim.app" android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- Persists the per-app language on Android 12 and older (Android 13+ stores it itself). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
